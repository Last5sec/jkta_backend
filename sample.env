# Cloudinary Configuration (for file uploads)
# Get from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (for sending confirmation emails)
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
# Optional: explicit TLS mode. Leave blank to auto-detect from SMTP_PORT
# (465 => true, 587/25 => false). Brevo uses 587 => false.
SMTP_SECURE=
# Optional: "From" address. Falls back to SMTP_EMAIL when unset.
SMTP_EMAIL_FROM=

# Shared secret required by the protected licence-resend endpoints
# (POST /resend-licence and /resend-licence-coach, header: x-resend-secret).
# If unset, the resend endpoints stay disabled (503).
LICENCE_RESEND_SECRET=

# MongoDB Database URL
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
DB_URL=

# Database Password (if needed separately)
DB_PASSWORD=

# Razorpay Credentials
# Get from: https://dashboard.razorpay.com/app/keys
# IMPORTANT: RAZORPAY_KEY_SECRET must NEVER be exposed on frontend
# Test Mode: rzp_test_XXXX / Live Mode: rzp_live_XXXX
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin Email (receives registration notifications)
ADMIN_EMAIL=

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (development/production)
NODE_ENV=production